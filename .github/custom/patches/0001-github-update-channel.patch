+fn process_software_update_check_response_github(bytes: Bytes) -> ResultType<()> {
+    let resp: Value = serde_json::from_slice(&bytes)?;
+    // GitHub 按发布时间倒序返回 Release；跳过 draft 与非版本号 tag（例如 master）。
+    let release_id = resp
+        .as_array()
+        .and_then(|releases| {
+            releases
+                .iter()
+                .filter(|release| {
+                    !release
+                        .get("draft")
+                        .and_then(|draft| draft.as_bool())
+                        .unwrap_or(false)
+                })
+                .filter_map(|release| release.get("tag_name").and_then(|tag| tag.as_str()))
+                .map(|tag| tag.trim().to_owned())
+                .find(|tag| get_version_number(tag) > 0)
+        })
+        .ok_or_else(|| anyhow!("no versioned release found in our update feed"))?;
+    let response_url = format!(
+        "https://github.com/{}/{}/releases/tag/{}",
+        UPDATE_REPO_OWNER, UPDATE_REPO_NAME, release_id
+    );
+    // 复用上游的校验链路：release_id 白名单 + 展示版本校验。
+    process_software_update_check_response(Bytes::from(json!({ "url": response_url }).to_string()))
